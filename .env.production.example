# Copy to .env.production on the deployment host. Do not commit that file.
CLOUDSHIELD_USERNAME=admin
CLOUDSHIELD_PASSWORD=replace-with-a-unique-password-at-least-12-characters
AWS_REGION=ap-south-1
SECONDARY_REGION=ap-southeast-1
SOURCE_BUCKET=replace-from-terraform-output
PRIMARY_BUCKET=replace-from-terraform-output
SECONDARY_BUCKET=replace-from-terraform-output
RECOVERY_BUCKET=replace-from-terraform-output
STATE_TABLE=replace-from-terraform-output
WORKER_FUNCTION=replace-from-terraform-output
SNS_TOPIC_ARN=replace-from-terraform-output
# Prefer an EC2 instance role containing the dashboard policy. No keys are needed then.
# CLOUDSHIELD_DOMAIN is passed to Docker Compose separately, not through this file.
GOOGLE_CLIENT_ID=replace-with-your-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
MAX_ACCOUNTS=100
MAX_BACKUPS_PER_ACCOUNT=30
