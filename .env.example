CLOUDSHIELD_MODE=local
CLOUDSHIELD_USERNAME=admin
CLOUDSHIELD_PASSWORD=replace-with-a-unique-long-password
CLOUDSHIELD_DATA_DIR=data
SERVER_ADDRESS=127.0.0.1
PORT=8080
# AWS mode also needs AWS SDK credentials (prefer an IAM role or AWS SSO profile).
AWS_REGION=ap-south-1
SECONDARY_REGION=ap-southeast-1
SOURCE_BUCKET=
PRIMARY_BUCKET=
SECONDARY_BUCKET=
RECOVERY_BUCKET=
STATE_TABLE=
WORKER_FUNCTION=
SNS_TOPIC_ARN=
# Optional HTTPS endpoint for worker alerts. Keep its URL out of source control.
ALERT_WEBHOOK_URL=
# Enable only when serving the dashboard through HTTPS.
COOKIE_SECURE=false
# Google sign-up (openid/profile/email only). Leave both blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAX_ACCOUNTS=100
MAX_BACKUPS_PER_ACCOUNT=30
