CLOUDSHIELD_MODE=local
CLOUDSHIELD_USERNAME=admin
CLOUDSHIELD_PASSWORD=replace-with-a-unique-long-password
SERVER_ADDRESS=127.0.0.1
PORT=8080
AZURE_PRIMARY_REGION=centralindia
AZURE_SECONDARY_REGION=koreacentral
AZURE_PRIMARY_ACCOUNT=replace-from-deployment-output
AZURE_SECONDARY_ACCOUNT=replace-from-deployment-output
AZURE_RECOVERY_ACCOUNT=replace-from-deployment-output
SOURCE_CONTAINER=source
PRIMARY_CONTAINER=backups
SECONDARY_CONTAINER=backups
RECOVERY_CONTAINER=recovery
STATE_TABLE=cloudshield
JOB_QUEUE=cloudshield-jobs
# Use az login locally; assign the documented data roles to the host identity in Azure.
ALERT_WEBHOOK_URL=
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAX_ACCOUNTS=10
MAX_BACKUPS_PER_ACCOUNT=240
MAX_OBJECTS=500
MAX_BYTES=20971520
